/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://formsubmit.co; base-uri 'self'; object-src 'none'; form-action 'self' mailto: https://formsubmit.co https://mail.google.com; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=604800
